<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PrintAI.Domain/PrintAI.Domain.csproj" />
    <ProjectReference Include="../PrintAI.Layout/PrintAI.Layout.csproj" />
    <ProjectReference Include="../PrintAI.Planning/PrintAI.Planning.csproj" />
    <ProjectReference Include="../PrintAI.Rendering/PrintAI.Rendering.csproj" />
    <ProjectReference Include="../PrintAI.SourceInspection/PrintAI.SourceInspection.csproj" />
    <ProjectReference Include="../PrintAI.Windows.Printing/PrintAI.Windows.Printing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ui\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
